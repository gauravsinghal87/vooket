APP_NAME="SuperApp"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=superapp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=superapp

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend origins. Used to build customer-facing links such as the password
# reset link. These are server-side only and are never exposed to the browser.
CUSTOMER_WEB_URL=http://localhost:5173
ADMIN_WEB_URL=http://localhost:5174

# Transactional SMTP.
# Prefer configuring SMTP in Admin > Integrations, which stores the credentials
# encrypted in the database. The values below are only a server-side fallback
# and should stay empty when the Admin-managed configuration is in use.
SMTP_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="${APP_NAME}"

# Password reset request limits. Counted per email + IP.
AUTH_FORGOT_PASSWORD_THROTTLE_MAX=5
AUTH_FORGOT_PASSWORD_THROTTLE_DECAY_MINUTES=10
AUTH_RESET_PASSWORD_THROTTLE_MAX=10
AUTH_RESET_PASSWORD_THROTTLE_DECAY_MINUTES=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================
# APPLICATION CONFIGURATION
# =============================================

SYSTEM_CONFIG_TABLE=enabled

# --- SMS ---
SMS_PROVIDER=log
SMS_TWILIO_SID=
SMS_TWILIO_TOKEN=
SMS_TWILIO_FROM=
SMS_MSG91_AUTH_KEY=
SMS_MSG91_SENDER_ID=

# --- Push Notifications ---
FCM_SERVER_KEY=
FCM_SENDER_ID=

# --- Maps ---
MAPS_PROVIDER=google

# Google Maps
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SECRET=

# --- Google Sign-In (backend token verification) ---
# Google publishes its ID-token signing keys (JWKS) at this URL, which is the
# value advertised in Google's own OpenID discovery document. Configurable only
# so the endpoint can be pointed at an operator-controlled mirror.
GOOGLE_JWKS_URL="https://www.googleapis.com/oauth2/v3/certs"
# Set to true only when an outbound filtering proxy answers 403 for the JWKS
# host. This stops the signing-key request being routed through
# HTTP_PROXY/HTTPS_PROXY. TLS certificate verification is never disabled.
GOOGLE_JWKS_BYPASS_PROXY=false

# Mapbox
MAPBOX_TOKEN=

# --- Outbound HTTPS / TLS trust ---
# Path to a CA bundle used for TLS peer + hostname verification on all
# outbound HTTPS calls (Razorpay, Google, etc.). Leave empty to use the
# vendored composer/ca-bundle. Only needed if the server provides a curated
# bundle. TLS verification is never disabled.
HTTP_CA_BUNDLE=
# Optional outbound proxy. Only affects routing, never TLS verification.
HTTP_PROXY=
HTTPS_PROXY=

# --- Payments ---
PAYMENT_PROVIDER=razorpay

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# --- Storage ---
STORAGE_PROVIDER=local
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_R2_ACCOUNT_ID=
STORAGE_R2_ACCESS_KEY=
STORAGE_R2_SECRET_KEY=
STORAGE_R2_BUCKET=

# --- AI ---
AI_PROVIDER=openai
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini

# --- KYC / Biometric ---
KYC_PROVIDER=hyperverge
KYC_HYPERVERGE_APP_ID=
KYC_HYPERVERGE_APP_KEY=
KYC_ONFIDO_API_TOKEN=
KYC_PERSONA_API_KEY=

# --- Analytics ---
ANALYTICS_PROVIDER=log

# --- Search ---
SEARCH_PROVIDER=mysql

# ================= Third-party integration mode =================
# mock: no external network calls (recommended for local dev / automated tests)
# test: real providers, test credentials
# live: real providers, live credentials
THIRD_PARTY_MODE=mock

# --- Maps ---
MAPS_PROVIDER=google
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=

# --- Payments ---
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Marketplace settlements (Razorpay Routes) ---
SETTLEMENT_PROVIDER=razorpay_route
RAZORPAY_ROUTING_ACCOUNT=
RAZORPAY_ROUTING_ACCOUNT_NUMBER=

# --- OTP / SMS (MSG91) ---
OTP_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# --- Push notifications (Firebase Cloud Messaging) ---
PUSH_PROVIDER=firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_API_KEY=

# --- Transactional email (Brevo) ---
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_NAME=
BREVO_SENDER_EMAIL=
BREVO_REPLY_TO=

# --- AI (Google Gemini) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=

# --- Media storage (Cloudinary) ---
MEDIA_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Captcha (Cloudflare Turnstile) ---
CAPTCHA_PROVIDER=turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics v2 (PostHog) ---
ANALYTICS_PROVIDER_V2=posthog
POSTHOG_KEY=
POSTHOG_HOST=

# --- Realtime (Laravel Reverb) ---
REALTIME_PROVIDER=reverb

VITE_APP_NAME="${APP_NAME}"

GEOCODING_NOMINATIM_EMAIL="admin@superapp.com"
