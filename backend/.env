THIRD_PARTY_MODE=test

# The local Privoxy instance (HTTPS_PROXY=127.0.0.1:8118) answers HTTP 403 for
# www.googleapis.com, so Google's signing keys (JWKS) could not be fetched and
# Google sign-in failed with 401. Reach Google directly for that one request.
# Certificate verification is unaffected. Set to false in environments that
# require the proxy to reach Google.
GOOGLE_JWKS_BYPASS_PROXY=true
