# Copy to `.env` and adjust for your environment. EXPO_PUBLIC_* values are
# inlined into the JS bundle at build time — never put secrets here.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Optional — development/production builds only. Public iOS OAuth client ID for
# Google sign-in (bundle id `com.superbasket.customer`). iOS sign-in needs it
# until a GoogleService-Info.plist ships with the build; Android does not.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=183311892884-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
